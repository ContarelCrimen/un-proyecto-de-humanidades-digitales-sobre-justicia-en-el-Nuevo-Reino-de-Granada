---
import { enlacesNav, type SeccionActiva } from './navegacion';

interface Props {
  active?: SeccionActiva;
}

const { active } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<nav class="topnav">
  <div class="nav-fondo"></div>

  <a href={`${base}index.html`} class="logo">
    <span class="logo-corto">Contar el crimen</span>
    <span class="logo-completo"
      >Contar el crimen: un proyecto de humanidades digitales<br />sobre justicia en el Nuevo Reino
      de Granada</span
    >
  </a>

  <button
    type="button"
    class="nav-toggle"
    aria-controls="nav-menu"
    aria-expanded="false"
    aria-label="Abrir menú"
  >
    <span class="nav-toggle-icono" aria-hidden="true"></span>
  </button>

  <div class="nav-links" id="nav-menu">
    {
      enlacesNav.map((enlace) => (
        <a href={enlace.href} aria-current={active === enlace.id ? 'page' : undefined}>
          {enlace.texto}
        </a>
      ))
    }
  </div>
</nav>

<script>
  import { initNavMenu } from '../scripts/ui/navMenu.js';

  initNavMenu();
</script>
