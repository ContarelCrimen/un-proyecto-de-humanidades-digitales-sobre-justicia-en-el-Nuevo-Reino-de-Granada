---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Button from '../../components/ui/Button.astro';
import FilterPanel from '../../components/ui/FilterPanel.astro';
import RangeSlider from '../../components/ui/RangeSlider.astro';
import Select from '../../components/ui/Select.astro';
import StatCard from '../../components/ui/StatCard.astro';

// baseDeDatosMain.js importaba style.css Y caso.css, así que esta página
// recibía las dos aunque caso.css sea sobre todo para el detalle del caso.
// Se conserva igual: las cadenas por página no cambian en este port.
import '../../styles/pages/caso.scss';
import '../../styles/pages/tablaGeneral.scss';
---

<BaseLayout title="Tablas y Filtros" active="base-de-datos">
  <main class="container pagina-dashboard">
    <PageHeader
      ceja="Archivo general"
      titulo="Base de datos de crímenes coloniales"
      idSubtitulo="tgSubtitulo"
    >
      <StatCard
        slot="extra"
        variante="compacta"
        valor="—"
        etiqueta="registros encontrados"
        idValor="tgConteo"
        idEtiqueta="tgConteoEtiqueta"
        vivo
        clase="tg-conteo"
      />
    </PageHeader>

    <FilterPanel
      formulario
      id="tgFiltros"
      etiquetaAria="Filtros de la tabla"
      clase="tg-filtros"
    >
      <Select
        etiqueta="Lugar"
        id="filtroLugar"
        opciones={[{ valor: '', texto: 'Todos los lugares' }]}
      />
      <Select
        etiqueta="Crimen"
        id="filtroCrimen"
        opciones={[{ valor: '', texto: 'Todos los crímenes' }]}
      />
      <Select
        etiqueta="Buscar en descripción"
        tipo="texto"
        id="busqueda"
        placeholder="Nombre, lugar o palabra clave..."
      />
      <span class="ui-filter-separator" aria-hidden="true"></span>
      <div class="tg-periodo">
        <RangeSlider
          etiqueta="Periodo"
          min={0}
          max={100}
          idRango="tgSlider"
          idMarcas="tgMarcas"
          idDesde="filtroAnioDesde"
          idHasta="filtroAnioHasta"
          idValor="tgPeriodoValor"
        />
      </div>
      <Fragment slot="acciones">
        <label class="tg-check" for="filtroCrimenesPenales">
          <input type="checkbox" id="filtroCrimenesPenales" />
          <span class="tg-check-caja" aria-hidden="true"></span>
          Solo crímenes penales
        </label>
        <Button variante="primario" tipo="submit">Buscar</Button>
      </Fragment>
    </FilterPanel>

    <div id="filtros-activos" class="tg-activos" hidden></div>

    <div id="tablaContainer" class="tg-tabla"></div>
  </main>

  <script>
    import { crearTabla } from '../../scripts/tables/tablageneral.js';

    crearTabla();
  </script>
</BaseLayout>
