---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Button from '../../components/ui/Button.astro';

import '../../styles/pages/caso.scss';

// Esta página no lleva nav. En su lugar tiene una barra propia (.caso-barra)
// con un enlace de vuelta a la tabla, y es la única de las 11 así. Por eso
// conNav={false}: ponerle el nav sería añadir algo que hoy no está.
//
// caso.ts completa "Volver a resultados", "Caso N de M" y Anterior / Siguiente:
// con la lista de la tabla si se llegó desde ella, o con todos los casos si no.
const base = import.meta.env.BASE_URL;
const tabla = `${base}base-de-datos/index.html`;
---

<BaseLayout title="Detalle del caso" conNav={false}>
  <header class="caso-barra">
    <div class="caso-barra-izquierda">
      <Button variante="fantasma" href={tabla} id="casoVolver" clase="caso-volver">
        Base de datos
      </Button>
      <span id="casoPosicion" class="caso-posicion"></span>
    </div>
    <nav id="casoNav" class="caso-nav" aria-label="Casos de los resultados" hidden>
      <Button tamano="sm" href={tabla} id="casoAnterior">‹ Anterior</Button>
      <Button tamano="sm" href={tabla} id="casoSiguiente">Siguiente ›</Button>
    </nav>
  </header>

  <main class="container pagina-dashboard" id="main-content">
    <PageHeader idCeja="casoCeja" idTitulo="casoTitulo" sinMayusculas oculto>
      <div slot="extra" class="ui-chip-group" id="casoMeta"></div>
    </PageHeader>
    <p class="state-msg" id="loading-msg">Cargando expediente…</p>
  </main>

  <script>
    import { inicializarCaso } from '../../scripts/tables/caso.js';

    inicializarCaso();
  </script>
</BaseLayout>
