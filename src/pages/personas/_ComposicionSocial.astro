---
// El guion bajo evita que Astro lo publique como ruta: es el cuerpo común de
// las dos páginas de esta carpeta (index.astro y otrosAgentes.astro), que solo
// cambian el modo.
import type { Modo } from '../../scripts/charts/ComposicionDatos';
import PageHeader from '../../components/PageHeader.astro';
import Button from '../../components/ui/Button.astro';
import Tabs from '../../components/ui/Tabs.astro';

// Hojas que siguen usando los sunbursts reutilizados (tooltip, botón "Ver
// casos", envoltorio y etiquetas) más la propia del layout.
import '../../styles/pages/tooltips.scss';
import '../../styles/pages/botones.scss';
import '../../styles/pages/graficos.scss';
import '../../styles/pages/sunburst.scss';
import '../../styles/pages/apilado.scss';
import '../../styles/pages/composicion.scss';

interface Props {
  modo: Modo;
}

const { modo } = Astro.props;
const base = import.meta.env.BASE_URL;

const esPersonas = modo === 'personas';
const titulo = esPersonas ? 'Personas' : 'Otros agentes';
const pista = esPersonas
  ? 'Haz clic en un género, un crimen o un nodo del grafo. Los demás paneles se actualizan.'
  : 'Haz clic en un tipo de agente, un crimen o un nodo del grafo. Los demás paneles se actualizan.';

const pestañas = [
  { modo: 'personas', texto: 'Personas', href: `${base}personas/index.html` },
  { modo: 'agentes', texto: 'Otros agentes', href: `${base}personas/otrosAgentes.html` },
] as const;
---

<main class="container pagina-dashboard" data-modo={modo}>
  <PageHeader ceja="Agentes registrados" titulo={titulo} subtitulo={pista} />

  <Tabs
    etiquetaAria="Tipo de agente"
    pestanas={pestañas.map((p) => ({ texto: p.texto, href: p.href, activa: p.modo === modo }))}
  />

  <div
    id="csFiltros"
    class="cs-filtros ui-filter-panel ui-filter-panel--fijo"
    role="group"
    aria-label="Filtros"
  >
  </div>

  <PageHeader nivel="seccion" titulo="¿Quién? Selecciona para mayor información" />
  <div id="csTarjetas" class="ui-stat-group"></div>
  <div id="csRol" class="cs-panel cs-panel--rol ui-clara" hidden></div>

  <section class="cs-panel ui-clara">
    <PageHeader
      nivel="subseccion"
      titulo={`${esPersonas ? 'Personas registradas' : 'Agentes registrados'} a lo largo del tiempo`}
      idSubtitulo="csLineaSubtitulo"
    />
    <div id="csLinea"></div>
  </section>

  <PageHeader nivel="seccion" titulo="¿Cómo se relacionan?" />
  <div id="csRejilla" class="cs-rejilla">
    <section class="cs-panel cs-panel--barras ui-clara">
      <PageHeader
        nivel="subseccion"
        titulo="Distribución por crímenes"
        subtitulo="Haz clic en un crimen para ver sus subcrímenes. También puedes interactuar con el sunburst o el grafo."
      />
      <div id="csBarras"></div>
    </section>

    <section class="cs-panel cs-panel--dona ui-clara">
      <PageHeader
        nivel="subseccion"
        titulo={`Recorrido por rol y ${esPersonas ? 'género' : 'tipo'}`}
        idSubtitulo="csDonaSubtitulo"
      />
      <div class="cs-herramientas" role="group" aria-label="Vista del gráfico circular">
        <Button id="csDonaNivel" tamano="sm" presionado={false}>Un nivel a la vez</Button>
        <Button id="csDonaAmpliar" tamano="sm" presionado={false}>Ampliar</Button>
      </div>
      <div id="csDonaGrafico"></div>
    </section>
  </div>

  <section class="cs-panel ui-clara">
    <PageHeader
      nivel="subseccion"
      titulo="Crímenes que suelen coincidir en un mismo caso"
      idSubtitulo="csRedSubtitulo"
      subtitulo="Puedes observar cuáles son los crímenes que más suceden en un mismo caso. Puedes hacer clic en los nodos para ver su conexión."
    />
    <div id="csRed"></div>
  </section>
</main>
